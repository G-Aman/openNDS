@@ -85,6 +85,8 @@
 	struct epoll_event *events;
 	int current_fd_count;
 	int number_of_count;
+	int maxevents;
+	int dead;
 	int i;
 
 	debug(LOG_DEBUG, "Starting ndsctl thread");
@@ -145,7 +147,17 @@
